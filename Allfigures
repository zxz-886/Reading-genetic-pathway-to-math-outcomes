r_matrix[lower.tri(r_matrix)] <- NA
r_vars <- melt(r_matrix, na.rm = TRUE)
colnames(r_vars) <- c("Var1", "Var2", "r")
r_vars$pair_var <- paste(r_vars$Var1, r_vars$Var2, sep = " ")


# Step 4: Melt sample size matrix
n_matrix <- cor_vars$n
n_matrix[lower.tri(n_matrix)] <- NA
n_vars <- melt(n_matrix, na.rm = TRUE)


colnames(n_vars) <- c("Var1", "Var2", "N")
n_vars$pair_var <- paste(n_vars$Var1, n_vars$Var2, sep = " ")

# Step 5: Melt p-value matrix
p_matrix <- cor_vars$P
p_matrix[lower.tri(p_matrix)] <- NA
p_vars <- melt(p_matrix, na.rm = TRUE)
colnames(p_vars) <- c("Var1", "Var2", "p")
p_vars$pair_var <- paste(p_vars$Var1, p_vars$Var2, sep = " ")

# Step 6: Merge all results
Rvars <- merge(r_vars[, c("pair_var", "r")], n_vars[, c("pair_var", "N")], by = "pair_var")
Rvars <- merge(Rvars, p_vars[, c("pair_var", "p")], by = "pair_var")

# Step 7: Extract original variable names
Rvars$var1 <- sapply(strsplit(Rvars$pair_var, " "), `[`, 1)
Rvars$var2 <- sapply(strsplit(Rvars$pair_var, " "), `[`, 2)

# Step 8: Compute confidence intervals
Rvars$lwr <- mapply(function(r, n) CIr(r, n, level = 0.95)[1], Rvars$r, Rvars$N)
Rvars$upr <- mapply(function(r, n) CIr(r, n, level = 0.95)[2], Rvars$r, Rvars$N)

