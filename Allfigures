## PGS plot
library(dplyr)
library(stringr)
library(forestploter)
library(glue)
library(forcats)

dat <- dat %>%
  mutate(PGS = recode(PGS,
    "PGS1" = "Nonword Reading PGS",
    "PGS2" = "Phoneme Awareness PGS",
    "PGS3" = "Nonword Repetition PGS",
    "PGS4" = "Spelling PGS",
    "PGS5" = "Word Reading PGS"
  ))

age_order <- c(7, 9, 12, 14, 16)

age_order <- sort(unique(as.numeric(dat$Age)))

#----plot for all teacher and web math 
dat1_all <- dat %>%
  rename(Estimate = Estimate, SE = SE) %>%
  mutate(
    SE   = as.numeric(SE),
    lwr  = Estimate - 1.96 * SE,
    upr  = Estimate + 1.96 * SE,
    PGS  = as.character(PGS),
    FDR_p = as.numeric(FDR_p)
  ) %>%
  arrange(PGS, Outcome) %>%      # or whatever ordering you prefer
  mutate(
    Est_disp = sprintf("%.2f [%+.2f, %+.2f]", Estimate, lwr, upr),
    stars = cut(
      FDR_p,
      breaks = c(-Inf, 0.01, 0.05, Inf),
      labels = c("**", "*", ""),
      right = TRUE
    ) |> as.character()
  )

dat1_all <- dat1_all %>%
  mutate(
    Math_Type = case_when(
      grepl("^[gijl].*tmat", Outcome) ~ "Teacher-rated",
      grepl("^(j|l|p|t)mat", Outcome) ~ "Web-based",
      grepl("gcse", Outcome, ignore.case = TRUE) ~ "GCSE",
    ),
    Age_num = case_when(
      grepl("^g", Outcome) ~ 7,      # gtmat1_z
      grepl("^i", Outcome) ~ 9,      # itmat1_z
      grepl("^jtmat", Outcome) ~ 10, # jtmat1_z
      grepl("^ltmat", Outcome) ~ 12, # ltmat1_z 

      grepl("gcse", Outcome, ignore.case = TRUE) ~ 16,

      grepl("^jmat", Outcome) ~ 10,  # jmat1_z
      grepl("^lmat", Outcome) ~ 12,  # lmatot1_z 
      grepl("^pmat", Outcome) ~ 16,  # pmat1_z 

      TRUE ~ NA_real_
    )
  ) %>%
  mutate(
   
    Math_Type = factor(
      Math_Type,
      levels = c("Teacher-rated", "GCSE", "Web-based"),
    ),
    Age = factor(Age_num, levels = c(7, 9, 10, 12, 16), ordered = TRUE)
  ) %>%
  arrange(PGS, Math_Type, Age)

dat1_blocks <- lapply(split(dat1_all, dat1_all$PGS), function(d_pgs) {
  # sort within each PGS by Math_Type then Age
  d_pgs <- d_pgs %>%
    arrange(Math_Type, Age)
  
  ## 1) PGS-level header row
  pgs_header <- tibble(
    PGS       = d_pgs$PGS[1],
    Math_Type = factor(NA, levels = levels(dat1_all$Math_Type)),
    Age       = factor(NA, levels = levels(dat1_all$Age), ordered = TRUE),
    N         = NA_integer_,
    Estimate  = NA_real_, 
    lwr       = NA_real_, 
    upr       = NA_real_,
    Est_disp  = "", 
    stars     = "",
    row_type  = "pgs_header",
    PGS_disp  = d_pgs$PGS[1],   # show PGS label here
    Math_disp = "",             # blank
    Age_disp  = ""              # blank
  )
  
  ## 2) Math-type blocks within this PGS
  type_blocks <- lapply(split(d_pgs, d_pgs$Math_Type), function(d_type) {
    # Math_Type header row
    type_header <- tibble(
      PGS       = d_type$PGS[1],
      Math_Type = d_type$Math_Type[1],
      Age       = factor(NA, levels = levels(dat1_all$Age), ordered = TRUE),
      N         = NA_integer_,
      Estimate  = NA_real_, 
      lwr       = NA_real_, 
      upr       = NA_real_,
      Est_disp  = "", 
      stars     = "",
      row_type  = "type_header",
      PGS_disp  = "",                               # PGS shown above
      Math_disp = as.character(d_type$Math_Type[1]),# show math-type label here
      Age_disp  = ""
    )
    
    body <- d_type %>%
      mutate(
        row_type  = "body",
        PGS_disp  = "",   # no PGS label on body rows
        Math_disp = "",   # no Math_Type label on body rows
        Age_disp  = as.character(as.integer(as.character(Age)))
      )
    
    bind_rows(type_header, body)
  })
  
  bind_rows(list(pgs_header, bind_rows(type_blocks)))
})

dat1_all_blocks <- bind_rows(dat1_blocks)

dall <- dat1_all_blocks %>%
  mutate(
    is_pgs_header  = row_type == "pgs_header",
    is_type_header = row_type == "type_header",
    is_body        = row_type == "body"
  ) %>%
    mutate(
    est   = ifelse(is_body, as.numeric(Estimate), NA_real_),
    lower = ifelse(is_body, as.numeric(lwr),      NA_real_),
    upper = ifelse(is_body, as.numeric(upr),      NA_real_)
  ) %>%
  transmute(
    `PGS` = ifelse(is_pgs_header, PGS_disp, ""),
    `Math Type` = ifelse(is_type_header, Math_disp, ""),
    `Math Age` = ifelse(is_body, Age_disp, ""),
