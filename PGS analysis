library(gee)
library(tidyverse)
library(psych)

# Standardize  PCs
df1$PC1 = scale(df1$PC1)
df1$PC2 = scale(df1$PC2)
df1$PC3 = scale(df1$PC3)
df1$PC4 = scale(df1$PC4)
df1$PC5 = scale(df1$PC5)
df1$PC6 = scale(df1$PC6)
df1$PC7 = scale(df1$PC7)
df1$PC8 = scale(df1$PC8)
df1$PC9 = scale(df1$PC9)
df1$PC10 = scale(df1$PC10)

# Standardize PGSs
df1$PGS1 = scale(df1$Nonwordreading_Eising2022)
df1$PGS2 = scale(df1$Phonemeawareness_Eising2022)
df1$PGS3 = scale(df1$Nonwordrepetition_Eising2022)
df1$PGS4 = scale(df1$Spelling_Eising2022)
df1$PGS5 = scale(df1$Wordreading_Eising2022)


# Variables 
pgs <- c('PGS1', 'PGS2', 'PGS3', 'PGS4', 'PGS5')
PC <- paste0("PC", 1:10, collapse = " + ")

outcomes <- c('gtmat1_z', 'itmat1_z', 'jtmat1_z', 'jmatt1_z', 'jmcat1t1_z','jmcat2t1_z', 'jmcat3t1_z', 'lmatot1_z', 'lma1tot1_z', 'lma2tot1_z', 'lma3tot1_z', 'ltmat1_z', 'pcexgcsematgrdm1_z', 'pcpvtot1_z', 'pcuntot1_z', 'pmatt1_z')
pgs_vars <- paste0("PGS", 1:5)
age_labels <- c("Age7", "Age9", "Age10", "Age12", "Age16")

# Run Models

lm_summary_list <- list()

## Loop over outcomes
for (i in seq_along(outcomes)) {
  outcome_var <- outcomes[i]
  age <- age_labels[i]
  predictors <- pgs_vars
  
  fml <- as.formula(paste(outcome_var, "~", paste(pgs_vars, collapse = "+")))
  
  LMfit <- lm(formula = fml, data = df1)
  lm_coef <- coef(summary(LMfit))
  n_obs <- nobs(LMfit)
  
  for (pgs in pgs_vars) {
    if (!pgs %in% rownames(lm_coef)) {
      next
    }
    
    est <- lm_coef[pgs, "Estimate"]
    se <- lm_coef[pgs, "Std. Error"]
    t_value <- lm_coef[pgs, "t value"]
    p_value <- lm_coef[pgs, "Pr(>|t|)"]
    ci <- confint(LMfit, parm = pgs, level = 0.95)
    
    lm_summary_list[[paste0(age, "_", pgs)]] <- data_frame(
      Outcome = outcome_var,
      Age = age,
      PGS = pgs,
      Estimate = est, 
      SE = se,
      T_value = t_value,
      P_value = p_value,
      ulb  = ci[1],
      lwb = ci[2],
      N = n_obs
    )
  }
}
lm_summary_all <- do.call(rbind, lm_summary_list)
rownames(lm_summary_all) <- NULL

# Adjust p-values
lm_summary_all$FDR_p <- p.adjust(lm_summary_all$P_value, method = "fdr")

# View summary
head(gee_summary_all)
